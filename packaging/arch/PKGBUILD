# Maintainer: INVENIA SYSTEMS <support@invenia.in>
#
# The Platform Manager (app/) as a pacman package, built from this checkout:
#   packaging/arch/build.sh   (sets pkgver from app/Cargo.toml, runs makepkg)
# The program lives where it installs itself (/opt/sentient-platform-manager),
# so its own "install the Platform Manager" step sees it is already in place.
pkgname=sentient-platform-manager
pkgver=0.0.0
pkgrel=1
pkgdesc="Install, run, update and back up the SENTIENT platform"
arch=('x86_64')
url="https://github.com/QuakeString/SENTIENT_Platform_Manager"
license=('LicenseRef-SENTIENT-EULA')
depends=('glibc' 'gcc-libs' 'fontconfig' 'freetype2' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'vulkan-icd-loader' 'vulkan-driver' 'alsa-lib' 'polkit' 'hicolor-icon-theme')
makedepends=('rust' 'rust-musl' 'musl' 'clang' 'cmake' 'pkgconf')
optdepends=('docker: run SENTIENT and PostgreSQL as containers'
            'docker-compose: the compose stack the manager drives'
            'postgresql: native installs use the distribution PostgreSQL'
            'kdialog: KDE Plasma file choosers (the portal may answer with the GTK one)')
# makepkg's LTO and debug defaults break or bloat the Rust build.
options=(!lto !debug)

_repo="$startdir/../.."

build() {
  cd "$_repo/app"
  # A kept target folder (packaging/arch/build-cached.sh) makes a rebuild
  # after a small change take minutes; a release build leaves it unset.
  export CARGO_TARGET_DIR="${SPM_CARGO_TARGET_DIR:-$srcdir/target}"
  export RUSTUP_TOOLCHAIN=stable
  unset CARGO_ENCODED_RUSTFLAGS LDFLAGS CFLAGS CXXFLAGS
  # The server agents first: the same job code without the window, static
  # (musl) for Linux so it runs on any server without desktop libraries.
  # The program carries every one (build.rs) and copies the right one to
  # the servers it manages. SPM_PREBUILT_AGENTS names a folder of agents
  # built elsewhere (build-cached.sh: the Windows and ARM64 ones need cross
  # toolchains Arch's rust does not ship; CI: its agents job), by their
  # release names; the x86_64 Linux one is built here when it is not there.
  local a="${SPM_PREBUILT_AGENTS:-/nonexistent}"
  if [ -f "$a/sentient-platform-manager-agent-linux-x86_64" ]; then
    export SPM_LINUX_AGENT="$a/sentient-platform-manager-agent-linux-x86_64"
  else
    CC_x86_64_unknown_linux_musl=musl-gcc \
      cargo build --release --locked --no-default-features --target x86_64-unknown-linux-musl
    export SPM_LINUX_AGENT="$CARGO_TARGET_DIR/x86_64-unknown-linux-musl/release/sentient-platform-manager"
  fi
  local name var
  for name in sentient-platform-manager-agent-linux-aarch64:SPM_LINUX_AARCH64_AGENT \
              sentient-platform-manager-agent-windows-x86_64.exe:SPM_WINDOWS_AGENT; do
    var=${name#*:}; name=${name%%:*}
    if [ -f "$a/$name" ]; then
      export "$var=$a/$name"
    else
      unset "$var"
      echo "warning: no $name: this package will not carry it (servers of that kind need a published release to download it from)" >&2
    fi
  done
  echo "Server agents carried: linux-x86_64=${SPM_LINUX_AGENT} linux-aarch64=${SPM_LINUX_AARCH64_AGENT:-none} windows=${SPM_WINDOWS_AGENT:-none}"
  cargo build --release --locked
}

package() {
  local opt="$pkgdir/opt/sentient-platform-manager"
  install -Dm755 "${SPM_CARGO_TARGET_DIR:-$srcdir/target}/release/sentient-platform-manager" "$opt/sentient-platform-manager"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/sentient-platform-manager/sentient-platform-manager "$pkgdir/usr/bin/sentient-platform-manager"
  install -Dm644 "$startdir/sentient-platform-manager.desktop" \
                 "$pkgdir/usr/share/applications/sentient-platform-manager.desktop"
  local n
  for n in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "$_repo/app/assets/app-icon/$n.png" \
                   "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/sentient-platform-manager.png"
  done
  install -Dm644 "$_repo/app/assets/app-icon/spm-app-icon.svg" \
                 "$pkgdir/usr/share/icons/hicolor/scalable/apps/sentient-platform-manager.svg"
  install -Dm644 "$_repo/app/assets/licence.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
