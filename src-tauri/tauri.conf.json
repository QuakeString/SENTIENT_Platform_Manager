{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SENTIENT Platform Manager",
  "version": "0.7.0",
  "identifier": "com.quakestring.sentient-manager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SENTIENT Platform Manager",
        "width": 900,
        "height": 660,
        "minWidth": 680,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "pgtools/bin/*"
    ],
    "publisher": "INVENIA SYSTEMS",
    "copyright": "Copyright 2026 INVENIA SYSTEMS",
    "shortDescription": "Install, run, update and back up the SENTIENT platform"
  }
}
